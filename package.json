{
  "name": "sgnl-mchn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sgnl/db generate",
    "db:migrate": "pnpm --filter @sgnl/db migrate",
    "db:push": "pnpm --filter @sgnl/db push",
    "db:studio": "pnpm --filter @sgnl/db studio",
    "seed": "pnpm --filter @sgnl/db seed",
    "api": "pnpm --filter @sgnl/api dev",
    "web": "pnpm --filter @sgnl/web dev"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  }
}
