# Postgres
DATABASE_URL=postgres://sgnl:sgnl@localhost:5432/sgnl

# API
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Workers
WORKERS_DATABASE_URL=postgres://sgnl:sgnl@localhost:5432/sgnl
WORKER_POLL_INTERVAL_MS=2000

# Blob store (local disk in MVP)
BLOB_STORE_PATH=./var/blobs

# Apify (optional, leave empty to disable)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=

# OpenAI (optional in MVP — detection LLM second-pass)
OPENAI_API_KEY=
OPENAI_DETECTION_MODEL=gpt-4o-mini

# System
NODE_ENV=development
LOG_LEVEL=info
